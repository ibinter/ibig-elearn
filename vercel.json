{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": [
    "cdg1"
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/rappel-inactif",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/conformite",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/email/digest-hebdo",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/leagues/process-week",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/rapports",
      "schedule": "30 6 * * *"
    }
  ]
}
